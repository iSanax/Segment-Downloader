# Polish translations

msgid ""
msgstr ""
"Project-Id-Version: Segment Downloader 1.0\n"
"Language: pl\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "BROWSE"
msgstr "WYBIERZ"

msgid "Checking file..."
msgstr "Sprawdzanie pliku..."

msgid "Clearing temporary files..."
msgstr "Czyszczenie plików tymczasowych..."

msgid "Could not determine the file size."
msgstr "Nie udało się ustalić rozmiaru pliku."

msgid "DOWNLOAD"
msgstr "POBIERZ"

msgid "Done"
msgstr "Gotowe"

msgid "Download completed"
msgstr "Pobieranie zakończone"

msgid "Download error"
msgstr "Błąd pobierania"

msgid "Downloading - {segment_count} segments"
msgstr "Pobieranie - {segment_count} segmentów"

msgid "Enter the file URL."
msgstr "Podaj URL pliku."

msgid "Enter the file extension."
msgstr "Podaj rozszerzenie pliku."

msgid "Enter the file name."
msgstr "Podaj nazwę pliku."

msgid "Error"
msgstr "Błąd"

msgid "Extension:"
msgstr "Rozszerzenie:"

msgid "File URL:"
msgstr "URL pliku:"

msgid "File name:"
msgstr "Nazwa pliku:"

msgid "Final file size is incorrect: {actual_size} != {expected_size}"
msgstr "Końcowy rozmiar pliku jest nieprawidłowy: {actual_size} != {expected_size}"

msgid "Language:"
msgstr "Język:"

msgid "Merging segments..."
msgstr "Łączenie segmentów..."

msgid "Missing segment: {path}"
msgstr "Brak segmentu: {path}"

msgid "Output directory:"
msgstr "Folder docelowy:"

msgid "Ready"
msgstr "Gotowy"

msgid "Segment Downloader"
msgstr "Segment Downloader"

msgid "Segment size (KB):"
msgstr "Rozmiar segmentu (KB):"

msgid "Segment {index}: expected {expected_size} bytes, received {actual_size}."
msgstr "Segment {index}: oczekiwano {expected_size} bajtów, otrzymano {actual_size}."

msgid "Segment {index}: incomplete response. Downloaded {actual_size} / {expected_size} bytes."
msgstr "Segment {index}: niepełna odpowiedź. Pobrano {actual_size} / {expected_size} bajtów."

msgid "Segment {index}: invalid Content-Range. Expected {start}-{end}, received: {received}"
msgstr "Segment {index}: nieprawidłowy Content-Range. Oczekiwano {start}-{end}, otrzymano: {received}"

msgid "Select an output directory."
msgstr "Wybierz folder docelowy."

msgid "Select output directory"
msgstr "Wybierz folder docelowy"

msgid "Starting..."
msgstr "Uruchamianie..."

msgid "Status:"
msgstr "Status:"

msgid "The file name and extension cannot contain path separators."
msgstr "Nazwa i rozszerzenie pliku nie mogą zawierać separatorów ścieżki."

msgid "The file was downloaded:\n\n{path}"
msgstr "Plik został pobrany:\n\n{path}"

msgid "The output directory cannot be located inside the temporary directory."
msgstr "Folder docelowy nie może znajdować się wewnątrz katalogu tymczasowego."

msgid "The segment size must be an integer greater than 0."
msgstr "Rozmiar segmentu musi być liczbą całkowitą większą od 0."

msgid "The server rejected the range request. HTTP {status_code}"
msgstr "Serwer odrzucił żądanie zakresu. HTTP {status_code}"

msgid "The server returned HTTP 206 without a Content-Range header."
msgstr "Serwer zwrócił HTTP 206 bez nagłówka Content-Range."

msgid "The temporary directory path is invalid."
msgstr "Ścieżka katalogu tymczasowego jest nieprawidłowa."

msgid "The thread count must be an integer greater than 0."
msgstr "Liczba wątków musi być liczbą całkowitą większą od 0."

msgid "Thread count:"
msgstr "Liczba wątków:"

msgid "Waiting for the server response..."
msgstr "Oczekiwanie na odpowiedź serwera..."

msgid "All segments downloaded. Merging file..."
msgstr "Wszystkie segmenty pobrane. Łączenie pliku..."

msgid "File saved successfully."
msgstr "Plik został pomyślnie zapisany."

msgid "Segment {index}/{segment_count} was already downloaded."
msgstr "Segment {index}/{segment_count} był już pobrany."

msgid "Segment {index}/{segment_count}: request attempt {attempt}/{retries}..."
msgstr "Segment {index}/{segment_count}: próba połączenia {attempt}/{retries}..."

msgid "Segment {index}/{segment_count} downloaded."
msgstr "Segment {index}/{segment_count} pobrany."

msgid "Segment {index}/{segment_count} failed after {retries} attempts ({error})."
msgstr "Segment {index}/{segment_count} nie powiódł się po {retries} próbach ({error})."

msgid "Segment {index}/{segment_count}: attempt {attempt}/{retries} failed ({error}). Retrying..."
msgstr "Segment {index}/{segment_count}: próba {attempt}/{retries} nie powiodła się ({error}). Ponawianie..."

msgid "Download stopped: {error}"
msgstr "Pobieranie zatrzymane: {error}"

msgid "CANCEL"
msgstr "ANULUJ"

msgid "Cancelling download..."
msgstr "Anulowanie pobierania..."

msgid "Download cancelled"
msgstr "Pobieranie anulowane"

msgid "Download cancelled."
msgstr "Pobieranie anulowane."

msgid "Download cancelled. Reusable segments were preserved."
msgstr "Pobieranie anulowane. Segmenty możliwe do wznowienia zostały zachowane."

msgid "The server does not support segmented downloads. Using one connection."
msgstr "Serwer nie obsługuje pobierania segmentowego. Używanie jednego połączenia."

msgid "Server check failed ({error}). Retrying in {seconds} s..."
msgstr "Sprawdzenie serwera nie powiodło się ({error}). Ponawianie za {seconds} s..."

msgid "Server returned HTTP {status_code}."
msgstr "Serwer zwrócił HTTP {status_code}."

msgid "The server returned HTTP 206 without a valid Content-Range header."
msgstr "Serwer zwrócił HTTP 206 bez prawidłowego nagłówka Content-Range."

msgid "Previous partial download does not match the remote file. Starting over."
msgstr "Poprzednie części nie pasują do pliku na serwerze. Rozpoczynanie od początku."

msgid "Found previous partial download. Resuming..."
msgstr "Znaleziono poprzednie części pliku. Wznawianie..."

msgid "Not enough free disk space. Required: {required}, available: {available}."
msgstr "Za mało wolnego miejsca na dysku. Wymagane: {required}, dostępne: {available}."

msgid "Segment {index}/{segment_count}: attempt {attempt}/{retries} failed ({error}). Retrying in {seconds} s..."
msgstr "Segment {index}/{segment_count}: próba {attempt}/{retries} nie powiodła się ({error}). Ponawianie za {seconds} s..."

msgid "The remote file changed during download. Start the download again."
msgstr "Plik na serwerze zmienił się podczas pobierania. Uruchom pobieranie ponownie."

msgid "Invalid Content-Range. Expected: {expected}, received: {received}."
msgstr "Nieprawidłowy Content-Range. Oczekiwano: {expected}, otrzymano: {received}."

msgid "Incomplete response. Downloaded {actual_size} / {expected_size} bytes."
msgstr "Niepełna odpowiedź. Pobrano {actual_size} / {expected_size} bajtów."

msgid "The file was already downloaded. Preparing output..."
msgstr "Plik został już pobrany. Przygotowywanie pliku wynikowego..."

msgid "Downloading with one connection: attempt {attempt}/{retries}..."
msgstr "Pobieranie jednym połączeniem: próba {attempt}/{retries}..."

msgid "Download attempt {attempt}/{retries} failed ({error}). Retrying in {seconds} s..."
msgstr "Próba pobierania {attempt}/{retries} nie powiodła się ({error}). Ponawianie za {seconds} s..."

msgid "Missing or incomplete segment: {index}"
msgstr "Brakujący lub niepełny segment: {index}"

msgid "The temporary output path is not a file: {path}"
msgstr "Tymczasowa ścieżka wynikowa nie jest plikiem: {path}"

msgid "Segment {index}/{segment_count}: request attempt {attempt}..."
msgstr "Segment {index}/{segment_count}: próba połączenia {attempt}..."

msgid "Segment {index}/{segment_count}: attempt {attempt} failed ({error}). Retrying in {seconds} s..."
msgstr "Segment {index}/{segment_count}: próba {attempt} nie powiodła się ({error}). Ponawianie za {seconds} s..."

msgid "Downloading with one connection: attempt {attempt}..."
msgstr "Pobieranie jednym połączeniem: próba {attempt}..."

msgid "Download attempt {attempt} failed ({error}). Retrying in {seconds} s..."
msgstr "Próba pobierania {attempt} nie powiodła się ({error}). Ponawianie za {seconds} s..."

msgid "Temporary files: calculating..."
msgstr "Pliki tymczasowe: obliczanie..."

msgid "Temporary files: clearing..."
msgstr "Pliki tymczasowe: czyszczenie..."

msgid "Temporary files: {size}"
msgstr "Pliki tymczasowe: {size}"

msgid "Temporary files: unavailable"
msgstr "Pliki tymczasowe: niedostępne"

msgid "OPEN"
msgstr "OTWÓRZ"

msgid "CLEAR"
msgstr "WYCZYŚĆ"

msgid "Clear temporary files"
msgstr "Wyczyść pliki tymczasowe"

msgid ""
"Delete all temporary download files?\n"
"\n"
"Saved progress for unfinished downloads will be lost."
msgstr ""
"Usunąć wszystkie tymczasowe pliki pobierania?\n"
"\n"
"Zapisany postęp niedokończonych pobrań zostanie utracony."

msgid "Temporary files were deleted."
msgstr "Pliki tymczasowe zostały usunięte."

msgid "Could not clear temporary files: {error}"
msgstr "Nie udało się usunąć plików tymczasowych: {error}"

msgid "Could not open the temporary directory: {error}"
msgstr "Nie udało się otworzyć folderu plików tymczasowych: {error}"

msgid "The output file already exists. Saving as {file_name}."
msgstr "Plik wynikowy już istnieje. Zapisywanie jako {file_name}."
